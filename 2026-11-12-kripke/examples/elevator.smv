-- A four-floor elevator with a SCAN controller (keep going in one direction while there is work
-- ahead, then reverse). `call` is a free input: any floor may be requested at any moment (4 = no call).
-- A button press for the floor the car is already standing at is ignored (see elevator_naive.smv
-- for what happens otherwise).
MODULE main
IVAR
  call : 0..4;
VAR
  floor : 0..3;
  dir   : {up, down};
  door  : {open, closed};
  p0 : boolean;  p1 : boolean;  p2 : boolean;  p3 : boolean;     -- pending requests
DEFINE
  here   := case floor = 0 : p0; floor = 1 : p1; floor = 2 : p2; TRUE : p3; esac;
  above  := (floor < 1 & p1) | (floor < 2 & p2) | (floor < 3 & p3);
  below  := (floor > 0 & p0) | (floor > 1 & p1) | (floor > 2 & p2);
  moving := door = closed & !here & (above | below);
ASSIGN
  init(floor) := 0;  init(dir) := up;  init(door) := closed;
  init(p0) := FALSE;  init(p1) := FALSE;  init(p2) := FALSE;  init(p3) := FALSE;

  next(door) := case
    door = open           : closed;            -- doors close after one step
    door = closed & here  : open;
    TRUE                  : door;
  esac;

  next(dir) := case
    door = open | here     : dir;
    dir = up   & !above & below : down;
    dir = down & !below & above : up;
    TRUE                   : dir;
  esac;

  next(floor) := case
    door = closed & !here & dir = up   & above : floor + 1;
    door = closed & !here & dir = down & below : floor - 1;
    door = closed & !here & dir = up   & !above & below : floor - 1;
    door = closed & !here & dir = down & !below & above : floor + 1;
    TRUE : floor;
  esac;

  next(p0) := case door = closed & here & floor = 0 : FALSE; call = 0 & floor != 0 : TRUE; TRUE : p0; esac;
  next(p1) := case door = closed & here & floor = 1 : FALSE; call = 1 & floor != 1 : TRUE; TRUE : p1; esac;
  next(p2) := case door = closed & here & floor = 2 : FALSE; call = 2 & floor != 2 : TRUE; TRUE : p2; esac;
  next(p3) := case door = closed & here & floor = 3 : FALSE; call = 3 & floor != 3 : TRUE; TRUE : p3; esac;

INVARSPEC NAME doors_closed_while_moving := !(door = open & moving)
SPEC NAME floor0_served := AG (p0 -> AF (floor = 0 & door = open))
SPEC NAME floor3_served := AG (p3 -> AF (floor = 3 & door = open))
SPEC NAME can_reach_top := EF floor = 3
SPEC NAME no_spurious_stops := AG (door = open -> !(AX door = open))
LTLSPEC NAME ltl_floor2_served := G (p2 -> F (floor = 2 & door = open))
