-- MSI cache-coherence protocol with three caches and a snooping bus.
-- Inputs: which cache acts and what it does. The single-writer / multiple-reader invariant
-- must hold on every interleaving.
MODULE main
IVAR
  who : 0..2;
  op  : {read, write, evict};
VAR
  c0 : {I, S, M};
  c1 : {I, S, M};
  c2 : {I, S, M};
DEFINE
  writers := (case c0 = M : 1; TRUE : 0; esac) + (case c1 = M : 1; TRUE : 0; esac) + (case c2 = M : 1; TRUE : 0; esac);
  readers := (case c0 = S : 1; TRUE : 0; esac) + (case c1 = S : 1; TRUE : 0; esac) + (case c2 = S : 1; TRUE : 0; esac);
ASSIGN
  init(c0) := I;  init(c1) := I;  init(c2) := I;

  next(c0) := case
    who = 0 & op = read  : case c0 = I : S; TRUE : c0; esac;
    who = 0 & op = write : M;
    who = 0 & op = evict : I;
    who != 0 & op = read  & c0 = M : S;      -- owner downgrades (writes back)
    who != 0 & op = write            : I;    -- invalidated by a remote write
    TRUE : c0;
  esac;
  next(c1) := case
    who = 1 & op = read  : case c1 = I : S; TRUE : c1; esac;
    who = 1 & op = write : M;
    who = 1 & op = evict : I;
    who != 1 & op = read  & c1 = M : S;
    who != 1 & op = write            : I;
    TRUE : c1;
  esac;
  next(c2) := case
    who = 2 & op = read  : case c2 = I : S; TRUE : c2; esac;
    who = 2 & op = write : M;
    who = 2 & op = evict : I;
    who != 2 & op = read  & c2 = M : S;
    who != 2 & op = write            : I;
    TRUE : c2;
  esac;

INVARSPEC NAME single_writer := writers <= 1
INVARSPEC NAME writer_excludes_readers := !(writers = 1 & readers > 0)
SPEC NAME can_share := EF readers = 3
SPEC NAME can_always_flush := AG EF (c0 = I & c1 = I & c2 = I)
SPEC NAME can_write_from_anywhere := AG EF c1 = M
