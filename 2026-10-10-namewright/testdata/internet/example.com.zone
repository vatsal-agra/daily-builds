; example.com — exercises most of the record types and lookup rules
$ORIGIN example.com.
$TTL 1h
@       IN SOA ns1.example.com. hostmaster.example.com. (
                2026101001 ; serial
                2h         ; refresh
                30m        ; retry
                1w         ; expire
                5m )       ; negative-cache TTL (minimum)
        IN NS  ns1
        IN MX  10 mail
        IN MX  20 mail2.example.com.
        IN TXT "v=spf1 mx -all"
        IN CAA 0 issue "letsencrypt.org"
ns1     IN A   198.51.100.10
mail    IN A   192.0.2.25
mail2   IN A   192.0.2.26
        IN AAAA 2001:db8::26
web     600 IN A 192.0.2.80
        600 IN A 192.0.2.81
        IN AAAA 2001:db8::80
www     IN CNAME web
www2    IN CNAME www           ; CNAME chain inside the zone
blog    IN CNAME blog.glueless.com.   ; CNAME leaving the zone
_sip._tcp IN SRV 10 60 5060 sip
sip     IN A   192.0.2.60
*.dev   IN A   192.0.2.99      ; wildcard
fixed.dev IN TXT "explicit beats wildcard"
a.b.c   IN A   192.0.2.7       ; creates empty non-terminals b.c and c
sub     IN NS  ns.sub          ; delegation with glue
ns.sub  IN A   198.51.100.11
; many TXT records so the RRset exceeds 512 bytes (forces UDP truncation)
big     IN TXT "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "1123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "2123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "3123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "4123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "5123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "6123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "7123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "8123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
big     IN TXT "9123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
