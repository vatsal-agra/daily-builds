// Two workers increment a shared counter with a non-atomic read-modify-write.
// A watcher waits until both are done and asserts that no increment was lost.
// expect: safety fail kind=assert

var counter = 0;
var done = 0;

proc Worker() {
    var tmp = 0;
    tmp = counter;
    tmp = tmp + 1;
    counter = tmp;
    atomic { done = done + 1; }
}

proc Watcher() {
    await done == 2;
    assert counter == 2, "lost update: counter != 2";
}

run Worker();
run Worker();
run Watcher();
