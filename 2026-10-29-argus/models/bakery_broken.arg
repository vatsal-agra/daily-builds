// Bakery with the `choosing` doorway removed: two processes can compute the same ticket
// *and* then see each other's ticket as zero, so mutual exclusion fails.
// expect: safety fail kind=invariant

const N = 2;
var number[N] : 0..N+1 = 0;
var in_cs = 0;

proc P(me) {
    var j = 0;
    var m = 0;
    j = 0;
    while (j < N) {
        if (number[j] > m) { m = number[j]; }
        j = j + 1;
    }
    number[me] = m + 1;
    j = 0;
    while (j < N) {
        if (j != me) {
            await number[j] == 0 || number[j] > number[me] || (number[j] == number[me] && j > me);
        }
        j = j + 1;
    }
    in_cs = in_cs + 1;
    in_cs = in_cs - 1;
    number[me] = 0;
}

for i in 0..N-1 { run P(i); }

invariant mutex: in_cs <= 1;
