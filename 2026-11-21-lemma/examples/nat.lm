-- Arithmetic on the natural numbers.  (add_comm, add_assoc, mul_comm … are already in the prelude;
-- here are further results proved on top of them.)

theorem mul_add_l (a b c : Nat) : (a + b) * c = a * c + b * c := by
  induction a as zero | succ k ih.
  { refl. }
  { simp [ih]. rewrite add_assoc. }

theorem mul_assoc (a b c : Nat) : (a * b) * c = a * (b * c) := by
  induction a as zero | succ k ih.
  { refl. }
  { simp [mul_add_l, ih]. }

theorem mul_one_l (n : Nat) : 1 * n = n := by
  simp [add_zero_r].

theorem add_cancel_r (a b c : Nat) (h : a + c = b + c) : a = b := by
  rewrite add_comm a c at h. rewrite add_comm b c at h.
  apply add_cancel_l c a b. exact h.

theorem le_antisym_zero (n : Nat) (h : n <= 0) : n = 0 := by
  cases h as intro k hk.
  cases n as zero | succ m.
  { refl. }
  { exfalso. apply zero_ne_succ (m + k). symm. rewrite add.eq_succ at hk. exact hk. }

-- a definition by structural recursion, and the equations it generates
def double (n : Nat) : Nat := elim n with | zero => 0 | succ k ih => succ (succ (double k)) end

theorem double_add (n : Nat) : double n = n + n := by
  induction n as zero | succ k ih.
  { refl. }
  { simp [ih, add_succ_r]. }

#eval double 21
#check double.eq_succ
