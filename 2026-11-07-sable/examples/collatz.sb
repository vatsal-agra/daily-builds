// longest Collatz chain below a bound; break/continue and nested loops
func steps(n) {
    var c = 0;
    while n != 1 {
        if n % 2 == 0 { n = n / 2; } else { n = 3 * n + 1; }
        c = c + 1;
    }
    return c;
}
func main() {
    var best = 0;
    var arg = 0;
    var i = 1;
    for ; i < 300; i = i + 1 {
        if i % 7 == 0 { continue; }
        var s = steps(i);
        if s > best { best = s; arg = i; }
        if best > 200 { break; }
    }
    print(arg);
    return best;
}
