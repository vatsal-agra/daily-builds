// wrapping arithmetic: a 64-bit LCG + xorshift mix, with many simultaneously live values
func main() {
    var s = 88172645463325252;
    var a = 1; var b = 2; var c = 3; var d = 4; var e = 5; var f = 6; var g = 7; var h = 8;
    for var i = 0; i < 60; i = i + 1 {
        s = s * 6364136223846793005 + 1442695040888963407;
        s = s ^ (s >> 13);
        s = s ^ (s << 7);
        a = a + (s & 255); b = b ^ a; c = c + b * 3; d = d - c; e = e ^ d;
        f = f + e % 1000; g = g * 31 + f; h = h ^ (g >> 3);
    }
    print(a + b + c + d); print(e + f + g + h);
    return (a ^ b ^ c ^ d ^ e ^ f ^ g ^ h) % 100000;
}
