// fixed-point (16.16) Mandelbrot escape counts: many live values -> register pressure
func mandel(cr, ci) {
    var zr = 0;
    var zi = 0;
    var i = 0;
    while i < 40 {
        var zr2 = (zr * zr) >> 16;
        var zi2 = (zi * zi) >> 16;
        if zr2 + zi2 > 4 << 16 { return i; }
        var t = zr2 - zi2 + cr;
        zi = ((zr * zi) >> 15) + ci;
        zr = t;
        i = i + 1;
    }
    return i;
}
func main() {
    var sum = 0;
    for var y = -20; y <= 20; y = y + 4 {
        for var x = -40; x <= 16; x = x + 4 {
            sum = sum + mandel(x * 1638, y * 3276);
        }
    }
    print(sum);
    return sum;
}
