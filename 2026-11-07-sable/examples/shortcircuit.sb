// short-circuit evaluation must skip side effects and traps
func noisy(x) { print(x); return x; }
func main() {
    var z = 0;
    if z != 0 && 10 / z > 1 { print(111); }
    if z == 0 || 10 / z > 1 { print(222); }
    var a = noisy(1) && noisy(0) && noisy(2);
    var b = noisy(0) || noisy(3) || noisy(4);
    print(a * 10 + b);
    return (1 && 2) + (0 || 0) + !5 + !0;
}
