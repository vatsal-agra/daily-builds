// Short-circuit && / || and unary ! — check() must NOT evaluate b>0 a
// second time if a>0 already decided the && (side effects don't apply
// here since args are pure, but the codegen path is still exercised).
fn check(a, b) {
    if (a > 0 && b > 0) {
        return 1;
    }
    if (a > 0 || b > 0) {
        return 2;
    }
    return 0;
}

fn not_test(a) {
    if (!(a == 0)) {
        return 1;
    }
    return 0;
}
