// Sieve of Eratosthenes — exercises global array memory (read + write).
array is_composite[64];

fn sieve(limit) {
    let i = 2;
    while (i * i < limit) {
        if (is_composite[i] == 0) {
            let j = i * i;
            while (j < limit) {
                is_composite[j] = 1;
                j = j + i;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn is_comp(i) {
    return is_composite[i];
}
