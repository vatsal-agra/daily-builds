// Bubble sort over a global int array with an initializer (data segment).
array arr[10] = {9, 3, 7, 1, 8, 2, 6, 4, 5, 0};

fn get(i) {
    return arr[i];
}

fn sort(n) {
    let i = 0;
    while (i < n) {
        let j = 0;
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                let tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
