// Word-frequency counter — strings, split, maps, and higher-order functions.

let text = "the quick brown fox the lazy dog the fox";

fn countWords(s) {
    let counts = {};
    let words = split(lower(s), " ");
    for (let i = 0; i < len(words); i = i + 1) {
        let w = words[i];
        if (has(counts, w)) {
            counts[w] = counts[w] + 1;
        } else {
            counts[w] = 1;
        }
    }
    return counts;
}

let counts = countWords(text);
let ks = keys(counts);

// Print each word and its count.
for (let i = 0; i < len(ks); i = i + 1) {
    print ks[i] + ": " + str(counts[ks[i]]);
}

// A tiny higher-order helper: apply a function to every element.
fn map(xs, f) {
    let out = [];
    for (let i = 0; i < len(xs); i = i + 1) {
        push(out, f(xs[i]));
    }
    return out;
}

print "words seen: " + str(len(ks));
print "uppercased: " + str(map(ks, upper));
