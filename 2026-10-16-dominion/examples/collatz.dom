// longest Collatz chain below a bound: while loops, div/rem by constants, mixed control flow
fn steps(n) {
    var c = 0;
    while n != 1 {
        if n % 2 == 0 { n = n / 2; } else { n = 3 * n + 1; }
        c += 1;
    }
    return c;
}
fn main() {
    var best = 0; var arg = 0;
    for var i = 1; i < 300; i += 1 {
        var s = steps(i);
        if s > best { best = s; arg = i; }
    }
    print(arg); print(best);
    return best;
}
