// N-queens by backtracking using bitmasks: deep recursion, many live values across calls
fn solve(n, cols, d1, d2) {
    var full = (1 << n) - 1;
    if cols == full { return 1; }
    var avail = full & ~(cols | d1 | d2);
    var total = 0;
    while avail != 0 {
        var bit = avail & -avail;
        avail = avail ^ bit;
        total += solve(n, cols | bit, ((d1 | bit) << 1) & full, (d2 | bit) >> 1);
    }
    return total;
}
fn main() {
    for var n = 4; n <= 8; n += 1 { print(solve(n, 0, 0, 0)); }
    return solve(6, 0, 0, 0);
}
