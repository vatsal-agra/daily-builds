; Cyclic garbage: reference counting could never reclaim this, tracing does.
(fn (ring n)
  (let ((head (cons 0 nil)) (cur nil) (i 1))
    (set! cur head)
    (while (< i n)
      (set-cdr! cur (cons i nil))
      (set! cur (cdr cur))
      (set! i (+ i 1)))
    (set-cdr! cur head)
    head))
(fn (ring-len r) (let ((n 1) (c (cdr r))) (while (not (eq c r)) (set! n (+ n 1)) (set! c (cdr c))) n))
(def survivor (ring 50))
(def total 0)
(let ((i 0))
  (while (< i 1500)
    (let ((r (ring 40))) (set! total (+ total (ring-len r))))
    (set! i (+ i 1))))
(print "garbage ring nodes visited" total)
(print "survivor ring length" (ring-len survivor) "digest" (digest survivor))
(assert (= (ring-len survivor) 50))
