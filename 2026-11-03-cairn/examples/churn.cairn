; A long-lived list survives while millions of short-lived pairs come and go.
(fn (range a b) (if (>= a b) nil (cons a (range (+ a 1) b))))
(fn (len xs) (let ((n 0)) (while (pair? xs) (set! n (+ n 1)) (set! xs (cdr xs))) n))
(def keep (range 0 1500))
(def round 0)
(def sink 0)
(while (< round 120)
  (let ((junk nil) (i 0))
    (while (< i 400)
      (set! junk (cons (cons i round) junk))
      (set! i (+ i 1)))
    (set! sink (+ sink (len junk))))
  (set! round (+ round 1)))
(print "kept" (len keep) "churned" sink "digest" (digest keep))
