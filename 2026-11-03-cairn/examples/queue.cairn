; Steady-state FIFO queue built from mutated pairs (tail pointer moves through young data).
(def head nil)
(def tail nil)
(def size 0)
(fn (push x)
  (let ((cell (cons x nil)))
    (if (nil? head) (begin (set! head cell) (set! tail cell))
        (begin (set-cdr! tail cell) (set! tail cell)))
    (set! size (+ size 1))))
(fn (pop)
  (let ((x (car head)))
    (set! head (cdr head))
    (when (nil? head) (set! tail nil))
    (set! size (- size 1))
    x))
(def i 0)
(def sum 0)
(while (< i 60000)
  (push (* i 3))
  (when (> size 200) (set! sum (+ sum (pop))))
  (set! i (+ i 1)))
(print "size" size "sum" sum "digest" (digest head))
