; Mixed object sizes freed in a different order than allocated: fragmentation stress.
(def slots (vector 300 nil))
(def live 0)
(def step 0)
(while (< step 6000)
  (let ((i (rand 300)) (n (+ 1 (rand 60))))
    (when (nil? (vref slots i)) (set! live (+ live 1)))
    (vset! slots i (vector n step)))
  (when (= (% step 3) 0)
    (vset! slots (rand 300) (str step)))
  (set! step (+ step 1)))
(let ((i 0) (vecs 0) (strs 0) (words 0))
  (while (< i 300)
    (let ((s (vref slots i)))
      (when (vector? s) (set! vecs (+ vecs 1)) (set! words (+ words (vlen s))))
      (when (string? s) (set! strs (+ strs 1))))
    (set! i (+ i 1)))
  (print "vectors" vecs "strings" strs "payload" words "digest" (digest slots)))
