; Old-to-young pointers: a big long-lived table is overwritten with fresh objects
; all the time. This is exactly what the generational write barrier exists for.
(def table (vector 2000 nil))
(def round 0)
(def acc 0)
(while (< round 30)
  (let ((i 0))
    (while (< i 2000)
      (vset! table i (cons (* i round) (cons round nil)))
      (set! i (+ i 7))))
  (set! round (+ round 1)))
(let ((i 0))
  (while (< i 2000)
    (let ((e (vref table i))) (when (pair? e) (set! acc (+ acc (+ (car e) (car (cdr e)))))))
    (set! i (+ i 1))))
(print "acc" acc "digest" (digest table))
