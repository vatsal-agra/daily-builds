#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "pinion/cli"

begin
  exit Pinion::CLI.run(ARGV)
rescue Interrupt
  exit 130
rescue Errno::EPIPE
  exit 0
rescue StandardError, SystemStackError => e
  warn "pinion: internal error: #{e.class}: #{e.message}"
  warn e.backtrace.first(5).map { |l| "  #{l}" } if ENV["PINION_DEBUG"]
  exit 70
end
